; Engine configuration file.
config_version=5

[application]

config/name="Reach"
run/main_scene="res://menu/menu.tscn"
config/features=PackedStringArray("4.7")

[display]

; Base/min design size. The window opens MAXIMIZED (mode=2) so the 2D canvas renders at
; the monitor's full native resolution instead of a fixed 1280x720 that the OS then
; upscales — that upscaling was what made the map read "extremely pixelated" on big or
; high-DPI screens. allow_hidpi keeps it rendering at true device pixels (no bitmap
; stretch) on scaled displays. Stretch stays "disabled" (1:1), so it's always crisp.
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/dpi/allow_hidpi=true

[rendering]

; Compatibility (OpenGL 3.3 / ES 3.0) instead of the default Forward+ (Vulkan). This is
; a flat 2D game, so it costs nothing visually, and it lets the alpha launch on old or
; integrated GPUs and virtual machines that lack Vulkan — fewer "won't start" reports.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 4x MSAA on the 2D canvas: smooths every drawn circle/line/arc edge (stars, borders,
; ships, rings) so the map reads crisp instead of jagged/pixelised.
anti_aliasing/quality/msaa_2d=2
